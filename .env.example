# Copy to .env, fill in real values, then: chmod 600 .env
# .env is git-ignored — never commit real values.

# Required for confidential columns to work at all. Generate with:
#   openssl rand -base64 32
# Losing this key permanently makes every column it protects unreadable —
# that is by design (see README), so back it up somewhere durable and
# separate from the database itself.
FX_MASTER_KEY=

# Real domain for automatic HTTPS via Caddy (docker-compose.prod.yml).
# Leave empty / set to "localhost" to test the deployment shape without a
# domain yet — Caddy still serves HTTPS, just with its own internal
# certificate instead of Let's Encrypt's, so a browser will warn.
DOMAIN=

# Postgres credentials — change from the "app"/"app" dev default before
# deploying anywhere reachable.
POSTGRES_USER=app
POSTGRES_PASSWORD=

# Comma-separated allowed origins for the API. Empty/"*" keeps local dev
# working; restrict to your real domain(s) once DOMAIN is set.
FX_CORS_ORIGINS=*

# Refuses an upload above this size (megabytes) before it's ever loaded
# into memory.
FX_MAX_UPLOAD_MB=200

# scripts/backup_postgres.sh: where dumps go, and how long they're kept.
FX_BACKUP_DIR=./backups
FX_BACKUP_KEEP_DAYS=14
